# ─────────────────────────────────────────────
# Multi-Agent Market Research — Environment Keys
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# OpenAI — Required for manager LLM and agent LLMs
OPENAI_API_KEY=sk-...

# Tavily Search API — Required for web scraper tool
TAVILY_API_KEY=tvly-...

# Optional: SerperDev fallback (set SEARCH_PROVIDER=serper to activate)
# SERPER_API_KEY=...

# ─── LLM Configuration ───────────────────────
# Manager LLM model (used by CrewAI hierarchical process)
MANAGER_LLM_MODEL=gpt-4o

# Agent LLM model (used by individual agents)
AGENT_LLM_MODEL=gpt-4o-mini

# ─── Search Provider ─────────────────────────
# Options: tavily | serper  (default: tavily)
SEARCH_PROVIDER=tavily
